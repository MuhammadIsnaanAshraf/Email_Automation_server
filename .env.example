# ─────────────────────────────────────────────────────────────
# Zenviqo backend — environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Server
PORT=4000
NODE_ENV=development

# Where the React frontend runs (used for CORS + post-login redirect)
FRONTEND_URL=http://localhost:5173

# Where the separate admin console SPA runs (also used for CORS)
ADMIN_URL=http://localhost:5174

# Public base URL of THIS backend (used to build the OAuth redirect URI)
BACKEND_URL=http://localhost:4000

# ── Google OAuth (Google Cloud Console → APIs & Services → Credentials) ──
# Create an "OAuth 2.0 Client ID" of type "Web application".
# Add this exact redirect URI in the console:
#   http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# ── Supabase (Project Settings → API) ──
# Use the SERVICE ROLE key on the backend only. Never expose it to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App secrets ──
# 32-byte key (hex, 64 chars) used to encrypt Google refresh tokens at rest.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-chars

# How long a login session lasts, in days
SESSION_TTL_DAYS=30

# ── Send pacing ──
# Default seconds between two consecutive emails when a campaign is scheduled.
# This is the PLATFORM fallback: an admin can override it per account from the
# admin console (stored on user_settings.send_gap_seconds), and that per-user
# value wins over this one. 120 = one email every 2 minutes.
SEND_DEFAULT_GAP_SECONDS=120

# ── Lead finder ──
# Apify API tokens, comma-separated, tried in order. When one hits its monthly
# usage limit the search continues on the next automatically; the exhausted key
# is skipped until its billing cycle resets (see GET /admin/lead-keys).
# Leave empty to switch the lead finder off.
APIFY_TOKENS=apify_api_xxx,apify_api_yyy
# Actor that takes { personTitle[], personCountry[], totalResults, companyMode }.
APIFY_LEADS_ACTOR_ID=T1XDXWc1L92AfIJtd
# Upper bound on "results" per search (each result costs provider credit).
LEADS_MAX_PER_SEARCH=500

# ─────────────────────────────────────────────────────────────
# Module 4 — Sending Engine (Supabase Edge Function secrets)
# These are NOT used by the Express server. Set them on the Edge Function with:
#   supabase secrets set KEY=value
# The Edge Function also needs SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, and TOKEN_ENCRYPTION_KEY (same values
# as above — TOKEN_ENCRYPTION_KEY MUST match so it can decrypt refresh tokens).
# ─────────────────────────────────────────────────────────────
# Shared secret pg_cron sends in the `x-tick-secret` header to authorize a tick.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEND_TICK_SECRET=replace-with-64-hex-chars
# Throttling knobs (safe defaults shown):
SEND_MAX_PER_PASS=200               # ceiling for a whole tick
SEND_MAX_PER_USER_PER_PASS=5        # anti-burst cap per account per tick
SEND_INTRA_PASS_DELAY_MS=8000       # gap between one account's sends in a pass
SEND_DEFAULT_DAILY_LIMIT=400        # per-account/day fallback (also users.daily_send_limit)
SEND_MAX_ATTEMPTS=5                 # retries before a transient failure is marked failed

# ─────────────────────────────────────────────────────────────
# Bounce & block detection (Supabase Edge Function secrets)
#
# The bounce-scan function reads the sending account's own mailbox for the
# delivery-failure notices that Gmail files there, parses the machine-readable
# delivery-status report, and suppresses an address after 2 hard bounces or 3
# consecutive blocks. Deploy with:
#   supabase functions deploy bounce-scan --no-verify-jwt
#
# REQUIRES the https://www.googleapis.com/auth/gmail.readonly scope. Accounts
# that connected before it was added keep sending normally, but their scan is
# recorded as 'missing_scope' until the user reconnects Gmail.
# ─────────────────────────────────────────────────────────────
# Shared secret pg_cron sends in `x-tick-secret`. If unset, the function falls
# back to SEND_TICK_SECRET, so this is optional.
BOUNCE_SCAN_SECRET=replace-with-64-hex-chars
# Hours a send waits with no failure notice before it counts as delivered.
# This is what resets a consecutive-block streak, so err on the long side.
BOUNCE_GRACE_HOURS=24
# Each pass re-reads this far before the last cursor. Overlap is free (repeated
# notices are deduped), and it stops a message slipping through a seam.
BOUNCE_SCAN_OVERLAP_MINUTES=90
# How far back an account's FIRST scan looks, so bounces from campaigns sent
# before this feature was switched on are still counted.
BOUNCE_INITIAL_LOOKBACK_DAYS=7
# How far back a notice may reach to claim a send by address alone.
BOUNCE_MATCH_LOOKBACK_DAYS=14
# Per-pass work limits (each message costs one Gmail API call).
BOUNCE_MAX_MESSAGES_PER_USER=60
BOUNCE_MAX_USERS_PER_PASS=25
BOUNCE_USER_CONCURRENCY=5

# ─────────────────────────────────────────────────────────────
# Engagement tracking — opens, clicks, replies (Edge Function secrets)
#
# Opens/clicks: send-tick adds a signed 1×1 pixel and rewrites links through
# the `track` function for campaigns that have tracking switched on. Deploy:
#   supabase functions deploy track --no-verify-jwt
# Replies: detected by the bounce-scan pass (same gmail.readonly scope), by
# reading inbound mail in the Gmail thread of each send. No extra cron.
#
# All optional — tracking works with none of these set.
# ─────────────────────────────────────────────────────────────
# HMAC key for pixel/redirect URLs (set on BOTH send-tick and track).
# Falls back to TOKEN_ENCRYPTION_KEY. Rotating it breaks links in emails
# already sent, so pick one and keep it.
TRACKING_SECRET=replace-with-64-hex-chars
# Public base URL of the track function. Defaults to
# https://<project>.supabase.co/functions/v1/track. Point it at a custom domain
# (e.g. https://t.yourdomain.com proxied to that URL) for better deliverability —
# links on a shared domain are a spam signal for cold email. Set on send-tick.
TRACKING_BASE_URL=
# Opens/clicks within this many seconds of the send are treated as security
# scanners fetching on delivery and not counted. Set on track.
TRACK_PREFETCH_SECONDS=10
# Reply detection knobs (set on bounce-scan).
REPLY_TRACKING_ENABLED=true
REPLY_MAX_LISTED_PER_USER=500
REPLY_MAX_FETCHED_PER_USER=100
REPLY_INITIAL_LOOKBACK_DAYS=7

# ─────────────────────────────────────────────────────────────
# Module 5 — Subscription reminders (Supabase Edge Function secrets)
# Also NOT used by the Express server. Set on the Edge Function with:
#   supabase secrets set KEY=value
# ─────────────────────────────────────────────────────────────
# Shared secret pg_cron sends in the `x-tick-secret` header to authorize a tick.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SUBSCRIPTION_REMINDER_SECRET=replace-with-64-hex-chars
# WhatsApp (Meta Cloud API — see backend/supabase/functions/subscription-reminders/whatsapp.ts
# for one-time setup: access token, phone number ID, and an APPROVED message template).
# Reminders are skipped (logged, not sent) until these are set.
WHATSAPP_PHONE_NUMBER_ID=your-cloud-api-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-cloud-api-access-token
WHATSAPP_TEMPLATE_NAME=subscription_expiring
WHATSAPP_TEMPLATE_LANG=en_US
